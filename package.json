{
  "name": "pi-callscript",
  "version": "0.1.3",
  "description": "One-tool code mode for Pi with parallel context, reasoning checkpoints, and reversible edits",
  "keywords": [
    "agentic-coding",
    "ai-agents",
    "callscript",
    "code-mode",
    "developer-tools",
    "effect",
    "effect-ts",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "tool-orchestration"
  ],
  "homepage": "https://github.com/codewithkenzo/pi-callscript#readme",
  "bugs": {
    "url": "https://github.com/codewithkenzo/pi-callscript/issues"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codewithkenzo/pi-callscript.git"
  },
  "bin": {
    "pi-callscript": "bin/pi-callscript.mjs"
  },
  "files": [
    "assets/",
    "bin/",
    "dist/",
    "skill/",
    "src/",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "smoke": "bun run build && bun run tests/pi-smoke.ts",
    "matrix": "bun run tests/local-install-reload.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "pack:check": "bun run check && npm pack --dry-run",
    "prepack": "bun run build"
  },
  "dependencies": {
    "callscript": "0.1.0",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@oxlint/plugins": "1.81.0",
    "@types/node": "26.4.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.65.0",
    "oxlint": "1.81.0",
    "tsdown": "0.22.14",
    "typebox": "1.3.7",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/codewithkenzo/pi-callscript/main/assets/pi-callscript.webp"
  }
}
